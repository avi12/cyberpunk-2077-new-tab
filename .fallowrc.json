{
  "$schema": "https://raw.githubusercontent.com/getfallow/fallow/main/schema/fallowrc.json",
  // The tray is a third way in: `cli.mjs start` spawns it by path rather than importing it, and it
  // is what the packaged app launches, so nothing statically reaches it.
  "entry": ["src/entrypoints/**", "scripts/*.mjs", "companion/packaging/*.mjs"],
  // Svelte 5 rune modules are `*.svelte.ts`, imported without the `.ts`. Fallow's resolver reads
  // `foo.svelte` as a component file and cannot follow the edge, so the modules are declared
  // reachable here and their specifiers exempted from the unresolved-import check.
  "dynamicallyLoaded": ["src/**/*.svelte.ts"],
  // Vite resolves `?raw` to the file's text; fallow sees the query and gives up on the path.
  "ignoreUnresolvedImports": ["@/assets/icons/*.svg?raw", "@/features/companion/connection.svelte", "@/lib/glitch.svelte", "@/lib/storage/settings.svelte", "./widget.svelte", "@/features/widgets/widget.svelte", "@/features/compose/access.svelte"],
  // Both are used through tooling rather than an import: the Svelte Vite plugin by
  // @wxt-dev/module-svelte, postcss-html as stylelint's customSyntax.
  "ignoreDependencies": ["@sveltejs/vite-plugin-svelte", "postcss-html"],
  "health": {
    "maxCognitive": 30,
    "maxCrap": 10000
  },
  "rules": {
    "unused-enum-members": "warn",
    // Svelte is a compiler: nothing it exports survives into the shipped bundle as a runtime
    // dependency, so it belongs in devDependencies.
    "dev-dependency-in-production": "off"
  }
}
