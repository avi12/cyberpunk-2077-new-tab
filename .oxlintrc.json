{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/oxlint-config-avi12/wxt.json", "./node_modules/oxlint-plugin-naming/preset.json"],
  "rules": {
    "naming/convention": [
      "error",
      {
        "presets": ["webextension-manifest", "webextension-messages", "hook-names"],
        "allowedNames": [
          {
            "reason": "A Vite define key that the hot client reads as a global",
            "names": ["__CP_HMR_DIR__"]
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/entrypoints/background.ts"],
      "rules": {
        "house/positional-parameters": "off"
      }
    }
  ],
  "ignorePatterns": [
    "node_modules/**",
    ".output/**",
    ".wxt/**",
    ".fallow/**",
    ".svelte-check/**",
    ".dev-logs/**",
    "reference/**",
    "companion/**"
  ]
}
