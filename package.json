{
  "name": "cyberpunk-2077-new-tab",
  "version": "0.0.4",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "description": "Jack into Night City on every new tab: a neon HUD, arranged your way",
  "author": "Avi <avi6106@gmail.com> (https://avi12.com)",
  "license": "GPL-3.0-or-later",
  "imports": {
    "#imports": "./.wxt/types/imports-module.d.ts"
  },
  "scripts": {
    "ext:dev": "wxt",
    "ext:dev:firefox": "wxt -b firefox",
    "ext:build": "wxt build",
    "ext:build:firefox": "wxt build -b firefox",
    "ext:zip": "wxt zip",
    "ext:zip:firefox": "wxt zip -b firefox",
    "ext:zip:all": "pnpm run ext:zip && pnpm run ext:zip:firefox",
    "ext:dev:hmr": "node scripts/dev.mjs",
    "ext:sideload": "node scripts/sideload.mjs",
    "lint": "avi12-lint",
    "svelte:check": "svelte-check --tsconfig ./tsconfig.json --tsgo",
    "fallow": "fallow audit --base HEAD",
    "icons:generate": "node scripts/generate-icons.mjs",
    "journeys": "node scripts/journeys.mjs",
    "journeys:status": "node scripts/journeys.mjs status",
    "journeys:stop": "node scripts/journeys.mjs stop",
    "journeys:uninstall": "node scripts/journeys.mjs uninstall",
    "journeys:package": "node scripts/journeys.mjs package",
    "postinstall": "wxt prepare",
    "fallow:all": "fallow dead-code --root .",
    "lint:fix": "avi12-lint --fix"
  },
  "dependencies": {
    "@webext-core/messaging": "^4.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.5",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@wxt-dev/module-svelte": "2.0.5",
    "avi12-lint": "github:avi12/lint-config#v0.4.7&path:/packages/avi12-lint",
    "chokidar": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-config-avi12": "github:avi12/lint-config#v0.4.7&path:/packages/eslint-config",
    "eslint-plugin-svelte": "3.23.1",
    "fallow": "^3.33.1",
    "fallow-config-avi12": "github:avi12/lint-config#v0.4.7&path:/packages/fallow-config",
    "oxfmt": "^0.78.0",
    "oxfmt-config-avi12": "github:avi12/lint-config#v0.4.7&path:/packages/oxfmt-config",
    "oxlint": "^1.90.0",
    "oxlint-config-avi12": "github:avi12/lint-config#v0.4.7&path:/packages/oxlint-config",
    "oxlint-plugin-naming": "github:avi12/lint-config#v0.4.7&path:/packages/oxlint-plugin-naming",
    "postcss": "^8.5.29",
    "postcss-html": "^1.8.1",
    "stylelint": "^17.16.0",
    "stylelint-config-avi12": "github:avi12/lint-config#v0.4.7&path:/packages/stylelint-config",
    "svelte": "5.57.2",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "1.9.0",
    "typescript": "6.0.3",
    "vite": "^8.3.4",
    "web-ext": "^10.7.0",
    "wxt": "^0.21.4"
  },
  "packageManager": "pnpm@11.1.2"
}
