{
  "name": "cyberpunk-2077-new-tab",
  "version": "1.0.0",
  "type": "module",
  "sideEffects": ["*.css"],
  "description": "A Cyberpunk 2077 themed new tab page: clock, search, quotes, netlinks seeded from your most-visited sites, and drag-ordered widgets.",
  "author": "Avi <avi6106@gmail.com> (https://avi12.com)",
  "license": "MIT",
  "imports": {
    "#imports": "./.wxt/types/imports-module.d.ts"
  },
  "scripts": {
    "ext:dev": "wxt",
    "ext:dev:firefox": "wxt -b firefox --mv3",
    "ext:build": "wxt build",
    "ext:build:firefox": "wxt build -b firefox --mv3",
    "ext:zip": "wxt zip",
    "ext:zip:firefox": "wxt zip -b firefox --mv3",
    "ext:dev:hmr": "node scripts/dev.mjs",
    "ext:sideload": "node scripts/sideload.mjs",
    "lint": "oxlint --type-aware --fix -c .oxlintrc.fix.json && eslint --fix && oxlint --type-aware",
    "stylelint": "stylelint . --fix",
    "svelte:check": "svelte-check --tsconfig ./tsconfig.json --tsgo",
    "fallow": "fallow audit --base HEAD",
    "icons:generate": "node scripts/generate-icons.mjs",
    "key:generate": "node scripts/generate-key.mjs",
    "journeys": "node scripts/journeys.mjs",
    "journeys:status": "node scripts/journeys.mjs status",
    "journeys:stop": "node scripts/journeys.mjs stop",
    "journeys:uninstall": "node scripts/journeys.mjs uninstall",
    "journeys:package": "node scripts/journeys.mjs package",
    "postinstall": "wxt prepare",
    "fallow:all": "fallow dead-code --root ."
  },
  "dependencies": {
    "@webext-core/messaging": "^4.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.4.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@wxt-dev/module-svelte": "2.0.5",
    "eslint": "^10.9.1",
    "eslint-plugin-import-newlines": "^2.0.0",
    "eslint-plugin-perfectionist": "^5.11.0",
    "eslint-plugin-svelte": "3.23.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fallow": "^3.22.0",
    "globals": "^17.12.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "postcss": "^8.5.28",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.14.1",
    "stylelint-config-ccb": "^3.32.0",
    "svelte": "5.57.0",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "1.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "web-ext": "^10.6.0",
    "wxt": "^0.21.4"
  },
  "packageManager": "pnpm@11.1.2"
}
